; TR_HUD_Fix - 32-bit (x86) exports for the d3d11.dll proxy (TRHF_PROXY build only).
;
; Left side  = exported (undecorated) name, as in the original d3d11.dll.
; Right side = internal symbol in src\dllmain.cpp:
;   Proxy_*  extern "C" __stdcall implementations (link.exe resolves the
;            undecorated name to _Proxy_D3D11CreateDevice@40 etc.)
;   Fwd_*    extern "C" __cdecl naked pass-through stubs (resolve lazily, then
;            jmp to the target export or to a fail stub with the correct
;            stdcall byte count). Keep in sync with TRHF_FORWARD_LIST.
LIBRARY d3d11
EXPORTS
    D3D11CreateDevice=Proxy_D3D11CreateDevice
    D3D11CreateDeviceAndSwapChain=Proxy_D3D11CreateDeviceAndSwapChain

    D3D11CoreCreateDevice=Fwd_D3D11CoreCreateDevice
    D3D11CoreCreateLayeredDevice=Fwd_D3D11CoreCreateLayeredDevice
    D3D11CoreGetLayeredDeviceSize=Fwd_D3D11CoreGetLayeredDeviceSize
    D3D11CoreRegisterLayers=Fwd_D3D11CoreRegisterLayers
    CreateDirect3D11DeviceFromDXGIDevice=Fwd_CreateDirect3D11DeviceFromDXGIDevice
    CreateDirect3D11SurfaceFromDXGISurface=Fwd_CreateDirect3D11SurfaceFromDXGISurface
    D3D11On12CreateDevice=Fwd_D3D11On12CreateDevice
    OpenAdapter10=Fwd_OpenAdapter10
    OpenAdapter10_2=Fwd_OpenAdapter10_2

    D3DKMTCloseAdapter=Fwd_D3DKMTCloseAdapter
    D3DKMTCreateAllocation=Fwd_D3DKMTCreateAllocation
    D3DKMTCreateContext=Fwd_D3DKMTCreateContext
    D3DKMTCreateDevice=Fwd_D3DKMTCreateDevice
    D3DKMTCreateSynchronizationObject=Fwd_D3DKMTCreateSynchronizationObject
    D3DKMTDestroyAllocation=Fwd_D3DKMTDestroyAllocation
    D3DKMTDestroyContext=Fwd_D3DKMTDestroyContext
    D3DKMTDestroyDevice=Fwd_D3DKMTDestroyDevice
    D3DKMTDestroySynchronizationObject=Fwd_D3DKMTDestroySynchronizationObject
    D3DKMTEscape=Fwd_D3DKMTEscape
    D3DKMTGetContextSchedulingPriority=Fwd_D3DKMTGetContextSchedulingPriority
    D3DKMTGetDeviceState=Fwd_D3DKMTGetDeviceState
    D3DKMTGetDisplayModeList=Fwd_D3DKMTGetDisplayModeList
    D3DKMTGetMultisampleMethodList=Fwd_D3DKMTGetMultisampleMethodList
    D3DKMTGetRuntimeData=Fwd_D3DKMTGetRuntimeData
    D3DKMTGetSharedPrimaryHandle=Fwd_D3DKMTGetSharedPrimaryHandle
    D3DKMTLock=Fwd_D3DKMTLock
    D3DKMTOpenAdapterFromHdc=Fwd_D3DKMTOpenAdapterFromHdc
    D3DKMTOpenResource=Fwd_D3DKMTOpenResource
    D3DKMTPresent=Fwd_D3DKMTPresent
    D3DKMTQueryAdapterInfo=Fwd_D3DKMTQueryAdapterInfo
    D3DKMTQueryAllocationResidency=Fwd_D3DKMTQueryAllocationResidency
    D3DKMTQueryResourceInfo=Fwd_D3DKMTQueryResourceInfo
    D3DKMTRender=Fwd_D3DKMTRender
    D3DKMTSetAllocationPriority=Fwd_D3DKMTSetAllocationPriority
    D3DKMTSetContextSchedulingPriority=Fwd_D3DKMTSetContextSchedulingPriority
    D3DKMTSetDisplayMode=Fwd_D3DKMTSetDisplayMode
    D3DKMTSetDisplayPrivateDriverFormat=Fwd_D3DKMTSetDisplayPrivateDriverFormat
    D3DKMTSetGammaRamp=Fwd_D3DKMTSetGammaRamp
    D3DKMTSetVidPnSourceOwner=Fwd_D3DKMTSetVidPnSourceOwner
    D3DKMTSignalSynchronizationObject=Fwd_D3DKMTSignalSynchronizationObject
    D3DKMTUnlock=Fwd_D3DKMTUnlock
    D3DKMTWaitForSynchronizationObject=Fwd_D3DKMTWaitForSynchronizationObject
    D3DKMTWaitForVerticalBlankEvent=Fwd_D3DKMTWaitForVerticalBlankEvent
